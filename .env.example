# Local: copy this file to .env, fill in your key, then restart npm start.
# Hosted: configure RIOT_API_KEY as a secret in the Site environment.
RIOT_API_KEY=
PORT=4173

# Enable the local-only developer Data Lab. Never enable on hosted deployments.
DATA_LAB_ENABLED=0

# Import ARAM Mayhem from the League client running on this machine (local only).
# Riot's public API does not serve Mayhem matches. Never enable on hosted deployments.
LCU_ENABLED=0
# Optional: League install folder when it is not found automatically.
LCU_INSTALL_DIR=

# Optional "Summarise with AI" in the coaching tab (local only). Any OpenAI-compatible API:
# Ollama (default below), LM Studio, OpenRouter, Gemini's compatibility endpoint, OpenAI.
AI_ENABLED=0
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:4b-instruct
# Leave empty for Ollama/LM Studio; set for hosted providers.
AI_API_KEY=
# Optional: none|low|medium|high. Set none for hybrid reasoning models such as qwen3:8b,
# which otherwise think before answering (several times slower). Leave empty if unsure.
AI_REASONING_EFFORT=
# Optional: your writing style for the AI (default .local/ai-style.md; see docs/ai-style.example.md).
AI_STYLE_FILE=
