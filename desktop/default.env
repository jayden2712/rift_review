# Rift Review desktop settings. Restart the app after editing.
# Keep this file private. It is stored on this computer, never inside the shared EXE.
RIOT_API_KEY=
LCU_ENABLED=1
LCU_INSTALL_DIR=
DATA_LAB_ENABLED=0
AI_ENABLED=0
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:4b-instruct
AI_API_KEY=
AI_REASONING_EFFORT=
# Relative paths here are relative to the desktop data folder.
# Empty means .local/ai-style.md in that folder.
AI_STYLE_FILE=
# Keep this stable: Chromium stores history by origin. Separate from web PORT=4173.
DESKTOP_PORT=4179
